    ],
    [
      "(2021)",
      "(1996)"
    ],
    [
      "の値は列方向 (縦方向) に読みます。",
      "の値は列番号 (横方向) から読みます。"
    ],
    [
      "x の値は行方向 (横方向) に読みます。",
      "x の値は行番号 (縦方向) から読みます。"
    ],
