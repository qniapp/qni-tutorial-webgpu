            "tex": "(\\langle 0|\\langle 🍎|)U^{\\dagger}_{CLONE} = \\langle🍎|\\langle🍎|",
            "display": true
          },
          {
            "tex": "\\begin{array}{l} &(\\langle 0|\\langle🍎|)U^{\\dagger}_{CLONE}U_{CLONE}(|👶\\rangle|0\\rangle) =\n  \\langle🍎|\\langle🍎|👶\\rangle|👶\\rangle \\\\ \\Rightarrow &\\langle 0|\\langle🍎|👶\\rangle|0\\rangle =\n  \\langle🍎|\\langle🍎|👶\\rangle|👶\\rangle \\\\ \\Rightarrow &\\langle🍎|👶\\rangle\\langle 0|0\\rangle =\n  \\langle🍎|👶\\rangle\\langle🍎|👶\\rangle \\\\ \\Rightarrow &\\langle🍎|👶\\rangle =\n  (\\langle🍎|👶\\rangle)^2 \\\\ \\end{array}",
            "display": true
          },
          {
            "tex": "\\langle🍎|👶\\rangle",
            "display": false
          },
