          {
            "tex": "\\left\\{ \\begin{array}{l} U_{CLONE}(|🍎\\rangle|0\\rangle) = |🍎\\rangle|🍎\\rangle \\\\\n  U_{CLONE}(|👶\\rangle|0\\rangle) = |👶\\rangle|👶\\rangle \\end{array} \\right.",
