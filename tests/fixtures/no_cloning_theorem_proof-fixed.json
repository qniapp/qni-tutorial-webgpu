    {
      "tex": "\\left\\{\\begin{array}{l}U_{CLONE}(|🍎\\rangle|0\\rangle)=|🍎\\rangle|🍎\\rangle\\\\U_{CLONE}(|👶\\rangle|0\\rangle)=|👶\\rangle|👶\\rangle\\end{array}\\right.",
      "display": true
    },
    {
      "tex": "(\\langle🍎|\\langle0|)U^{\\dagger}_{CLONE}=\\langle🍎|\\langle🍎|",
      "display": true
    },
    {
      "tex": "\\begin{array}{l}&(\\langle🍎|\\langle0|)U^{\\dagger}_{CLONE}U_{CLONE}(|👶\\rangle|0\\rangle)=\\langle🍎|\\langle🍎|👶\\rangle|👶\\rangle\\\\\\Rightarrow&(\\langle🍎|\\langle0|)(|👶\\rangle|0\\rangle)=\\langle🍎|\\langle🍎|👶\\rangle|👶\\rangle\\\\\\Rightarrow&\\langle🍎|👶\\rangle\\langle0|0\\rangle=\\langle🍎|👶\\rangle\\langle🍎|👶\\rangle\\\\\\Rightarrow&\\langle🍎|👶\\rangle=(\\langle🍎|👶\\rangle)^2\\\\\\end{array}",
      "display": true
