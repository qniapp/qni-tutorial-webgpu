{
  "name": "qni-tutorial-webgpu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/copy-mathjax.mjs && astro dev",
    "build": "node scripts/copy-mathjax.mjs && astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "fetch:embed": "node scripts/fetch-qni-embed.mjs",
    "test:unit": "node --experimental-strip-types --test tests/qni-app-url.unit.mjs tests/tutorial-embed.unit.mjs && playwright test --config playwright.unit.config.ts",
    "test:migration": "node --test tests/migration-build.unit.mjs",
    "test:pinned-embed-mobile": "node scripts/test-pinned-embed-mobile.mjs",
    "test": "playwright test"
  },
  "dependencies": {
    "astro": "7.3.8",
    "mathjax": "3.2.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22",
    "typescript": "6.0.3"
  }
}
