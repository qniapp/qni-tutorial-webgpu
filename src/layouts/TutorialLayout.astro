---
import Sidebar from '../components/Sidebar.astro'

interface Props {
  title: string
  description: string
  section?: string
  hasCircuit?: boolean
  hasMath?: boolean
}
const { title, description, section, hasCircuit = false, hasMath = false } = Astro.props
const base = import.meta.env.BASE_URL
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{title} | Qni Tutorial</title>
    {hasMath && <Fragment>
      <script is:inline>
        window.MathJax = {
          startup: {
            ready() {
              MathJax.startup.defaultReady()
              MathJax.startup.promise.then(() => {
                performance.mark('mathjax-typeset-complete')
                document.documentElement.dataset.mathjax = 'ready'
              })
            },
          },
        }
      </script>
      <script is:inline id="MathJax-script" defer src={`${base}mathjax/tex-chtml.js`}></script>
    </Fragment>}
    {hasCircuit && <script is:inline define:vars={{ qniEmbedBase: `${base}qni-webgpu/` }}>
      if (navigator.gpu) {
        for (const file of ['qni-embed.mjs', 'qni-web.js', 'qni-web_bg.wasm']) {
          const link = document.createElement('link')
          link.href = qniEmbedBase + file
          link.rel = file.endsWith('.wasm') ? 'preload' : 'modulepreload'
          if (file.endsWith('.wasm')) {
            link.as = 'fetch'
            link.type = 'application/wasm'
            link.crossOrigin = 'anonymous'
          }
          document.head.append(link)
        }
        // Warm the driver during download. Rust/wgpu acquires its own device;
        // a speculative device would allocate unused resources.
        if (navigator.gpu.requestAdapter) navigator.gpu.requestAdapter().catch(() => {})
        import(qniEmbedBase + 'qni-embed.mjs').then(module => module.prepareEmbed()).catch(() => {})
      }
    </script>}
  </head>
  <body>
    <div class="page-shell">
    <aside class="sidebar">
      <Sidebar variant="static" />
    </aside>
    <dialog class="toc-drawer" id="toc-drawer" aria-label="目次">
      <div class="toc-drawer-panel">
        <button type="button" class="toc-close" aria-label="目次を閉じる" autofocus>
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M6 18 18 6M6 6l12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </button>
        <Sidebar variant="drawer" />
      </div>
    </dialog>
    <div class="page-column">
    <header class="site-header">
      <button type="button" class="toc-open" aria-label="目次を開く" aria-controls="toc-drawer" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
      <a href={base}>Qni Tutorial</a>
      <span>実験版</span>
    </header>
    <main>
      <div class="page-title-block">
        {section && <p class="section-label">{section}</p>}
        <h1>{title}</h1>
        <p class="lede">{description}</p>
      </div>
      <div class="content-with-margin"><slot /></div>
    </main>
    <footer>
      <a href={base}>ページ一覧</a>
      <p>WebGPU 対応ブラウザで使う実験版です。回路の変更は保存されません。</p>
    </footer>
    </div>
    </div>
    <script>
      import '../components/toc-drawer'
      import '../components/qni-webgpu-circuit'
      import '../components/h-gate'
      if (document.querySelector('qubit-circle')) import('../components/qubit-circle')
    </script>
  </body>
</html>
<style is:global>
  /* Flexoki Light: bg, bg-2, ui-2, tx, tx-2, blue-600. */
  :root {
    color-scheme: light;
    --bg: #fffcf0;
    --bg-2: #f2f0e5;
    --border: #dad8ce;
    --text: #100f0f;
    --muted: #6f6e69;
    --link: #205ea6;
    font-family: system-ui, sans-serif;
    color: var(--text);
    background: var(--bg);
  }
  * { box-sizing: border-box; }
  body { margin: 0; }
  a { color: var(--link); text-underline-offset: 4px; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--link); outline-offset: 4px; }
  .site-header, main, footer { max-width: 1120px; margin-inline: auto; padding: 24px; }
  .site-header { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border); }
  .site-header a { font-weight: 600; text-decoration: none; }
  .site-header span, .section-label { color: var(--muted); font-size: 14px; line-height: 20px; }
  main { padding-block: 48px; }
  h1 { margin: 8px 0 16px; font-size: 36px; line-height: 40px; }
  h2 { margin: 48px 0 16px; font-size: 24px; line-height: 32px; }
  h3 { font-size: 20px; line-height: 28px; }
  p, li { font-size: 16px; line-height: 28px; }
  p { max-width: 76ch; margin: 16px 0; }
  .lede { color: var(--muted); font-size: 20px; line-height: 28px; margin-bottom: 32px; }
  /* Original page.html: mb-10 border-b border-zinc-200 pb-10.
     Its inline H1 row adds 1px before mt-1; preserve that visual gap
     without changing our existing title font or the site header/footer. */
  .page-title-block { border: 0 solid #E4E4E7; border-bottom-width: 1px; padding-bottom: 40px; margin-bottom: 40px; }
  .page-title-block h1 { margin-bottom: 0; }
  .page-title-block .lede { margin-top: 5px; margin-bottom: 0; }
  .static-diagram { max-width: 76ch; border: 1px solid var(--border); border-radius: 12px; background: var(--bg-2); padding: 16px 24px; margin: 24px 0; }
  .static-diagram p { margin: 8px 0; }
  qni-webgpu-circuit { clear: both; margin: 24px 0; }
  figure { max-width: 640px; margin: 24px 0; }
  figure img { display: block; width: 100%; height: auto; }
  figcaption, footer p { color: var(--muted); font-size: 14px; line-height: 20px; }
  details { max-width: 76ch; border-bottom: 1px solid var(--border); padding: 16px 0; }
  summary { cursor: pointer; line-height: 28px; }
  footer { border-top: 1px solid var(--border); }
  /* Reserve a right margin for notes. Start at the note breakpoint so the
     original's 640-767px negative margin cannot cause horizontal overflow. */
  @media (min-width: 640px) {
    .content-with-margin > p,
    .content-with-margin > ul,
    .content-with-margin > figure,
    .content-with-margin > .static-diagram,
    .content-with-margin > details { width: 58.333333%; margin-right: auto; }
  }
  /* Original page.html: md (768px) fixed w-64 sidebar; below it a menu
     button opens an off-canvas drawer (here a modal <dialog>). */
  .sidebar { display: none; }
  .toc-open { display: none; }
  @media (min-width: 768px) {
    .page-shell { display: grid; grid-template-columns: 256px minmax(0, 1fr); }
    .sidebar {
      display: block; position: sticky; top: 0; height: 100vh; overflow-y: auto;
      border-right: 1px solid var(--border);
    }
  }
  @media (max-width: 767.98px) {
    .toc-open {
      display: inline-flex; align-items: center; justify-content: center;
      width: 40px; height: 40px; margin: -8px 8px -8px -8px; padding: 0;
      border: 0; border-radius: 6px; background: none; color: var(--muted); cursor: pointer;
    }
    .toc-open:hover { background: var(--bg-2); color: var(--text); }
    .toc-open:focus-visible, .toc-close:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
    .site-header > a { margin-right: auto; }
    html:has(.toc-drawer[open]) { overflow: hidden; }
  }
  .toc-drawer {
    margin: 0; padding: 0; border: 0;
    width: min(320px, calc(100vw - 56px)); max-width: none; height: 100dvh; max-height: none;
    background: var(--bg); color: var(--text);
  }
  .toc-drawer::backdrop { background: rgb(16 15 15 / 0.5); }
  .toc-drawer-panel { height: 100%; overflow-y: auto; }
  .toc-close {
    position: sticky; top: 0; z-index: 1; display: flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; margin: 8px 8px 0 auto; padding: 0;
    border: 0; border-radius: 6px; background: var(--bg); color: var(--muted); cursor: pointer;
  }
  .toc-close:hover { background: var(--bg-2); color: var(--text); }
  @media (max-width: 640px) {
    .site-header, main, footer { padding-inline: 16px; }
    h1 { font-size: 30px; line-height: 36px; }
  }
</style>
