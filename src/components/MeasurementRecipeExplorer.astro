<measurement-recipe-explorer data-original-image>
  <p>入力は |+i⟩ = (|0⟩ + i|1⟩)/√2 です。質問に合わせて基底を変換してから、通常の 0/1 測定をします。</p>
  <label>元の状態への質問：<span data-question-value>Y</span>
    <input data-question type="range" min="0" max="2" step="1" value="2" aria-valuetext="Y を測ります" />
  </label>
  <label>測定前の段階：<span data-step-value>0 / 2：入力（変換前）</span>
    <input data-step type="range" min="0" max="2" step="1" value="0" aria-valuetext="段階 0 / 2、入力（変換前）" />
  </label>
  <svg data-sequence viewBox="0 0 400 100" role="img" aria-label="Y の手順は S†、H、Measure です。現在は入力です。">
    <path class="wire" d="M15 45 H385" />
    <rect class="gate" x="8" y="27" width="66" height="36" /><text x="41" y="50" text-anchor="middle">|+i⟩</text>
    <g data-first-gate><rect class="gate" x="100" y="27" width="54" height="36" /><text data-first-name x="127" y="50" text-anchor="middle">S†</text></g>
    <g data-second-gate><rect class="gate" x="195" y="27" width="54" height="36" /><text x="222" y="50" text-anchor="middle">H</text></g>
    <rect class="gate" x="290" y="27" width="100" height="36" /><text x="340" y="50" text-anchor="middle">Measure</text>
    <path data-stage-marker class="stage-marker" d="M78 10 V75" />
    <text x="200" y="95" text-anchor="middle">緑の線の位置の振幅を下に表示します。</text>
  </svg>
  <p data-recipe class="hint">Y の手順：S† → H → Measure です。</p>
  <div class="circles">
    {[0, 1].map(index => <svg data-amplitude={index} viewBox="0 0 180 200" role="img" aria-label={`|${index}⟩ の振幅の円表記です。`}>
      <circle class="surface" cx="90" cy="85" r="60" />
      <circle data-disc class="disc" cx="90" cy="85" r={60 / Math.SQRT2} />
      <circle class="rim" cx="90" cy="85" r="60" />
      <path class="axis" d="M25 85 H155 M90 150 V20" />
      <line data-phase class="phase" x1="90" y1="85" x2={index === 0 ? 90 + 60 / Math.SQRT2 : 90} y2={index === 0 ? 85 : 85 - 60 / Math.SQRT2} />
      <text x="90" y="174" text-anchor="middle">|{index}⟩ の振幅</text>
      <text data-probability x="90" y="195" text-anchor="middle">確率 50.0%</text>
    </svg>)}
  </div>
  <p class="hint">外側の円は振幅の大きさ 1 です。塗った円の半径は振幅の大きさ、面積は確率です。線の向きは複素位相（右が実部の正、上が虚部の正）です。</p>
  <output aria-live="polite" aria-atomic="true">段階 0 / 2：入力（変換前）です。
|0⟩ の振幅 = 0.707 + 0.000i、|1⟩ の振幅 = 0.000 + 0.707i です。
現在ここで 0/1 測定した場合：P(0) = 50.0%、P(1) = 50.0% です。
変換途中です。この確率はまだ元の Y の質問への答えではありません。</output>
  <p class="hint">スライダーは測定前の変換をたどります。Measure はまだ実行しません。最終変換後に限り、出力 0/1 の確率が元の質問の +1/−1 の確率になります。Z は変換なしなので、段階 0 が最終段階です。</p>
</measurement-recipe-explorer>

<script>
  import { MeasurementBasisMath as MathBasis } from './measurement-basis-math'
  class MeasurementRecipeExplorer extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return
      this.dataset.ready = 'true'
      const questionInput = this.querySelector<HTMLInputElement>('[data-question]')!
      const stepInput = this.querySelector<HTMLInputElement>('[data-step]')!
      const text = (name: string, value: string) => { this.querySelector(`[data-${name}]`)!.textContent = value }
      const update = () => {
        const question = MathBasis.questions[Number(questionInput.value)]!
        const recipe = MathBasis.recipe(question)
        const step = Math.min(Number(stepInput.value), recipe.length)
        stepInput.max = String(recipe.length)
        stepInput.value = String(step)
        const label = step === 0 ? '入力（変換前）' : `${recipe.slice(0, step).join(' → ')} 適用後`
        const stage = `段階 ${step} / ${recipe.length}：${label}`
        text('question-value', question)
        text('step-value', `${step} / ${recipe.length}：${label}`)
        questionInput.setAttribute('aria-valuetext', `${question} を測ります`)
        stepInput.setAttribute('aria-valuetext', stage)
        const sequence = `${question} の手順：${[...recipe, 'Measure'].join(' → ')} です。${recipe.length === 0 ? '変換はありません。' : ''}`
        text('recipe', sequence)
        this.querySelector('[data-sequence]')!.setAttribute('aria-label', `${sequence}現在は ${stage} です。`)
        this.querySelector('[data-first-gate]')!.setAttribute('display', recipe.length ? 'inline' : 'none')
        this.querySelector('[data-second-gate]')!.setAttribute('display', recipe.length === 2 ? 'inline' : 'none')
        text('first-name', recipe[0] ?? '')
        const x = [78, 170, 265][step]
        this.querySelector('[data-stage-marker]')!.setAttribute('d', `M${x} 10 V75`)
        const state = MathBasis.premeasurement(MathBasis.state(90, 90), question, step)
        const probabilities = MathBasis.probabilities(state)
        for (const svg of this.querySelectorAll<SVGSVGElement>('[data-amplitude]')) {
          const index = Number(svg.dataset.amplitude), amplitude = state[index]!, p = probabilities[index]!
          svg.querySelector('[data-disc]')!.setAttribute('r', String(60 * Math.sqrt(p)))
          svg.querySelector('[data-phase]')!.setAttribute('x2', String(90 + 60 * amplitude.re))
          svg.querySelector('[data-phase]')!.setAttribute('y2', String(85 - 60 * amplitude.im))
          svg.querySelector('[data-probability]')!.textContent = `確率 ${MathBasis.percent(p)}`
          svg.setAttribute('aria-label', `${stage}です。|${index}⟩ の振幅 = ${MathBasis.amplitude(amplitude)}、現在ここで 0/1 測定する確率は ${MathBasis.percent(p)} です。`)
        }
        const result = `${stage}です。\n|0⟩ の振幅 = ${MathBasis.amplitude(state[0])}、|1⟩ の振幅 = ${MathBasis.amplitude(state[1])} です。\n現在ここで 0/1 測定した場合：P(0) = ${MathBasis.percent(probabilities[0])}、P(1) = ${MathBasis.percent(probabilities[1])} です。\n`
        this.querySelector('output')!.textContent = result + (step === recipe.length
          ? `最終変換後です。元の ${question} の質問の P(+1 / 出力 0) = ${MathBasis.percent(probabilities[0])}、P(−1 / 出力 1) = ${MathBasis.percent(probabilities[1])} です。`
          : `変換途中です。この確率はまだ元の ${question} の質問への答えではありません。`)
      }
      questionInput.addEventListener('input', update)
      stepInput.addEventListener('input', update)
      update()
    }
  }
  if (!customElements.get('measurement-recipe-explorer')) customElements.define('measurement-recipe-explorer', MeasurementRecipeExplorer)
</script>

<style>
  measurement-recipe-explorer { display:block; box-sizing:border-box; width:100%; max-width:540px; margin-block:1.5rem; margin-inline:0 auto; padding:1rem; color:#100F0F; background:#FFFCF0; border:1px solid #4385BE; border-radius:8px; line-height:1.7; }
  p { margin:0 0 1rem; }
  label, output { display:block; }
  .circles { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0.5rem; }
  svg { display:block; width:100%; height:auto; min-width:0; }
  text { font:14px system-ui,sans-serif; fill:#100F0F; }
  .wire, .axis { fill:none; stroke:#B7B5AC; }
  .gate { fill:#FFFCF0; stroke:#4385BE; }
  .stage-marker { fill:none; stroke:#24837B; stroke-width:4; }
  .surface { fill:#FFFCF0; }
  .disc { fill:#92BFDB; }
  .rim { fill:none; stroke:#4385BE; }
  .phase { stroke:#100F0F; stroke-width:2; }
  input[type="range"] { display:block; box-sizing:border-box; width:100%; min-height:44px; margin:0; accent-color:#24837B; writing-mode:horizontal-tb; }
  input[type="range"], input[type="range"]:hover, input[type="range"]:active, input[type="range"]:focus, input[type="range"]:focus-visible, input[type="range"]:disabled { outline:none; border:none; box-shadow:none; }
  input[type="range"]:focus-visible::-webkit-slider-thumb { box-shadow:0 0 0 3px #24837B; }
  input[type="range"]:focus-visible::-moz-range-thumb { box-shadow:0 0 0 3px #24837B; }
  output { display:block; white-space:pre-line; margin:1rem 0; padding:0.75rem; background:#F2F0E5; border-radius:6px; overflow-wrap:anywhere; font-variant-numeric:tabular-nums; }
  .hint { color:#6F6E69; font-size:0.9em; }
</style>
