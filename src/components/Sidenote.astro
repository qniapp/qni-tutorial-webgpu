---
interface Props {
  /** Unique within the page, so each label toggles only its own note. */
  id: string
  numbered?: boolean
}
const { id, numbered = false } = Astro.props
const inputId = `margin-note-${id}`
---
<label for={inputId} class:list={['margin-note__toggle', { 'margin-note--numbered': numbered, 'margin-note__toggle--unnumbered': !numbered }]} aria-label="注釈を開閉"></label><input type="checkbox" id={inputId} class="margin-note__toggle margin-note__input" /><span class="margin-note"><slot /></span>

<style is:global>
  /* Ported from qni apps/tutorial/css/margin_note.css. No JavaScript needed. */
  body { counter-reset: margin-note-counter; }
  .margin-note {
    position: relative;
    font-size: 14px;
    line-height: 20px;
    /* Flexoki base-700: about 7:1 on the cream background. */
    color: #575653;
    display: none;
    vertical-align: baseline;
    float: left;
    clear: both;
    margin: 16px;
    width: 91.666667%;
    /* Long URLs in credits must wrap in the narrow 768px margin column. */
    overflow-wrap: anywhere;
  }
  /* Original image credits live in a Tailwind not-prose figure. */
  figure .margin-note a { color: inherit; text-decoration: none; }
  .margin-note--numbered { counter-increment: margin-note-counter; }
  .margin-note__input { display: none; }
  .margin-note__toggle:checked + .margin-note { display: block; }
  label.margin-note__toggle::after {
    position: relative;
    font-size: 14px;
    line-height: 20px;
    border-radius: 4px;
    padding-inline: 2px;
    background: #e0f2fe;
    top: -8px;
    vertical-align: baseline;
    /* The word joiner keeps the marker on the line of the preceding word. */
    content: '\2060…';
  }
  label.margin-note--numbered::after { content: '\2060' counter(margin-note-counter); }
  label.margin-note--numbered + input + .margin-note::before {
    position: relative;
    top: -8px;
    padding-right: 4px;
    content: counter(margin-note-counter);
  }
  @media (min-width: 640px) {
    .margin-note {
      display: block;
      vertical-align: middle;
      float: right;
      clear: right;
      /* Fill the content area right of the prose column (see TutorialLayout). */
      margin: 0 calc(var(--prose-width) - 100cqw) 12px 0;
      padding-left: 32px;
      width: calc(100cqw - var(--prose-width));
    }
    label.margin-note__toggle::after { padding-inline: 0; background: transparent; }
    label.margin-note__toggle--unnumbered::after { display: none; }
  }
</style>
