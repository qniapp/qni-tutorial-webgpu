---
import { MatrixMath } from './matrix-adjoint-math'
import { InnerProductMath as C } from './basis-inner-product-math'
const initial = MatrixMath.gate('H')
const state = C.state(100, 60)
---
<matrix-vector-explorer>
  <p>ゲートの行列を、入力の縦ベクトルに掛けてみましょう。各行の2つの積を足すと、出力の振幅になります。</p>
  <label>ゲート：<span data-gate-name>H</span>
    <input data-gate type="range" min="0" max="5" step="1" value="2" aria-valuetext="H" />
  </label>
  <label>Ry の回転角 θ（度）<input data-theta type="range" min="0" max="360" step="1" value="60" disabled /></label>
  <label>入力の分布角 t（度）<input data-population type="range" min="0" max="180" step="1" value="100" /></label>
  <label>入力の相対位相 φ（度）<input data-phase type="range" min="-180" max="180" step="1" value="60" /></label>
  <p class="hint">α = cos(t/2)、β = sin(t/2)e^(iφ) です。|α|² + |β|² = 1 になる入力を使います。</p>
  <label>入力の例：<span data-example-name>初期の入力</span>
    <input data-example type="range" min="0" max="3" step="1" value="1" aria-valuetext="初期の入力" />
  </label>
  <figure data-original-image>
    <div class="states">
      {['入力', 'ゲート適用後'].map((label, index) => <div>
        <p>{label}</p>
        <svg data-state={index} viewBox="0 0 230 130" role="img" aria-label={`${label}の円表記`}>
          {[0, 1].map(i => <g transform={`translate(${60 + 110 * i} 52)`}>
            <circle r="42" class="surface" /><circle data-disc r="0" class="disc" />
            <circle r="42" class="rim" /><line x1="0" y1="0" x2="0" y2="0" />
            <text x="0" y="66" text-anchor="middle">|{i}⟩</text>
          </g>)}
        </svg>
      </div>)}
    </div>
    <figcaption>半径は振幅の大きさ、針は位相です。位相は右向きから反時計回りに測ります。振幅が 0 のとき、針は表示されません。</figcaption>
  </figure>
  <div class="calculation">
    <div><p>行列（近似値）</p><div class="matrix" data-matrix aria-label="ゲートの行列">
      {initial.flat().map((z, i) => <span data-cell={i}>{C.format(z)}</span>)}
    </div></div>
    <div><p>入力ベクトル（近似値）</p><div class="vector" aria-label="入力ベクトル">
      {state.map((z, i) => <span data-input={i}>{C.format(z)}</span>)}
    </div></div>
  </div>
  <label>注目する行：<span data-row-name>1 行目（α′）</span>
    <input data-row type="range" min="0" max="1" step="1" value="0" aria-valuetext="1 行目（α′）" />
  </label>
  <output aria-live="polite" aria-atomic="true">
    <span data-angles></span>
    <span data-work="0"></span><span data-work="1"></span>
  </output>
  <p class="hint">選んだ行と、掛け合わせる入力の両成分・積を強調しています。小数は丸めた近似値です。計算には丸める前の値を使います。</p>
</matrix-vector-explorer>

<script>
  import { MatrixMath as M, paintState, type GateName } from './matrix-adjoint-math'
  import { InnerProductMath as C } from './basis-inner-product-math'
  class MatrixVectorExplorer extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return
      this.dataset.ready = 'true'
      const gate = this.querySelector<HTMLInputElement>('[data-gate]')!
      const input = (name: string) => this.querySelector<HTMLInputElement>(`[data-${name}]`)!
      const t = input('population'), phase = input('phase'), theta = input('theta')
      const rowInput = input('row'), example = input('example')
      const gates: GateName[] = ['X', 'Z', 'H', 'S', 'S†', 'Ry']
      const examples = ['自由入力', '初期の入力', '入力 |0⟩', '入力 |1⟩']
      const update = () => {
        const gateName = gates[Number(gate.value)]
        const row = Number(rowInput.value) as 0 | 1
        const rowName = ['1 行目（α′）', '2 行目（β′）'][row]
        for (const [control, name, label] of [[gate, 'gate', gateName], [rowInput, 'row', rowName], [example, 'example', examples[Number(example.value)]]] as const) {
          control.setAttribute('aria-valuetext', label)
          this.querySelector(`[data-${name}-name]`)!.textContent = label
        }
        theta.disabled = gateName !== 'Ry'
        for (const slider of [t, phase, theta]) slider.setAttribute('aria-valuetext', `${slider.value} 度`)
        const matrix = M.gate(gateName, Number(theta.value) * Math.PI / 180)
        const state = C.state(Number(t.value), Number(phase.value)), result = M.apply(matrix, state)
        this.querySelector('[data-angles]')!.textContent = `t = ${t.value}°、φ = ${phase.value}°${gateName === 'Ry' ? `、θ = ${theta.value}°` : ''}`
        matrix.flat().forEach((z, i) => {
          const cell = this.querySelector<HTMLElement>(`[data-cell="${i}"]`)!
          cell.textContent = C.format(z); cell.classList.toggle('selected', Math.floor(i / 2) === row)
        })
        state.forEach((z, i) => {
          const cell = this.querySelector<HTMLElement>(`[data-input="${i}"]`)!
          cell.textContent = C.format(z); cell.classList.add('selected')
        })
        for (const r of [0, 1] as const) {
          const products = M.products(matrix, state, r)
          const work = this.querySelector<HTMLElement>(`[data-work="${r}"]`)!
          work.textContent = `${r + 1} 行目：${r === 0 ? 'α′' : 'β′'} ≈ (${C.format(matrix[r][0])}) × (${C.format(state[0])}) + (${C.format(matrix[r][1])}) × (${C.format(state[1])})\n≈ (${C.format(products[0])}) + (${C.format(products[1])}) ≈ ${C.format(result[r])}`
          work.classList.toggle('selected', r === row)
        }
        paintState(this.querySelector<SVGSVGElement>('[data-state="0"]')!, state, '入力')
        paintState(this.querySelector<SVGSVGElement>('[data-state="1"]')!, result, 'ゲート適用後')
      }
      this.querySelectorAll('input').forEach(control => control.addEventListener('input', () => {
        if (control === example) {
          const preset = Number(example.value)
          if (preset > 0) { t.value = ['100', '0', '180'][preset - 1]; phase.value = preset === 1 ? '60' : '0' }
        } else if (control === t || control === phase) example.value = '0'
        update()
      }))
      update()
    }
  }
  if (!customElements.get('matrix-vector-explorer')) customElements.define('matrix-vector-explorer', MatrixVectorExplorer)
</script>

<style>
  matrix-vector-explorer { display:block; box-sizing:border-box; width:100%; max-width:680px; margin:1.5rem auto; margin-inline:0 auto; padding:1rem; background:#FFFCF0; color:#100F0F; border:1px solid #4385BE; border-radius:8px; }
  p { line-height:1.7; } label, output, output > span { display:block; }
  input[type="range"] { display:block; box-sizing:border-box; width:100%; min-height:44px; margin:0 0 8px; accent-color:#24837B; outline:none; }
  input[type="range"]:focus, input[type="range"]:focus-visible { outline:none; }
  input[type="range"]:focus-visible::-webkit-slider-thumb { box-shadow:0 0 0 3px #24837B; }
  input[type="range"]:focus-visible::-moz-range-thumb { box-shadow:0 0 0 3px #24837B; }
  input:disabled { opacity:0.5; cursor:not-allowed; }
  figure { margin:1rem 0; } .states { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; text-align:center; }
  svg { display:block; width:100%; height:auto; } .surface { fill:#FFFCF0; } .disc { fill:#92BFDB; } .rim { fill:none; stroke:#4385BE; } line { stroke:#100F0F; stroke-width:2; } text { fill:#100F0F; font:16px system-ui,sans-serif; }
  .calculation { display:grid; grid-template-columns:minmax(0,1.3fr) minmax(0,1fr); gap:12px; margin-bottom:16px; }
  .matrix { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); }
  .matrix, .vector { border-inline:2px solid #4385BE; padding:4px; text-align:center; }
  .matrix span, .vector span { display:block; padding:6px 2px; }
  .selected { background:#DDF1EF; box-shadow:inset 3px 0 #24837B; }
  output { margin:1rem 0; } output > span { padding:8px; margin:8px 0; white-space:pre-line; }
  output, .calculation { font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
  .hint, figcaption { color:#6F6E69; font-size:0.9em; line-height:1.6; }
  @media(max-width:420px) { .calculation { grid-template-columns:1fr; } }
</style>
