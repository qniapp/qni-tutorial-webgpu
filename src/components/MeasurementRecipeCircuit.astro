---
import { sources, pin } from 'virtual:qni-measurement-design'
// Unmodified components/CSS from the same pinned Qni checkout as the app.
// A separate registry is necessary: TutorialLayout registers legacy names too.
const scripts = Object.entries(sources).filter(([name]) => name.endsWith('.js')).map(([, source]) => `<script>${source.replaceAll('</script', '<\\/script')}</script>`).join('')
const document = `<!doctype html><html lang="ja"><meta charset="utf-8"><style>${sources['design-system.css']}</style>
<style>
body { min-height:0; padding:0; background:var(--bg); }
.sequence { display:flex; position:relative; width:224px; margin:auto; padding-block:10px; }
.input { width:56px; flex-shrink:0; align-self:center; text-align:center; }
.marker { position:absolute; top:4px; bottom:4px; width:3px; background:var(--cyan-600); left:56px; }
</style><body data-qni-pin="${pin}"><div class="sequence">
<span class="input">|+i⟩</span><circuit-dropzone id="first"><s-dagger-gate></s-dagger-gate></circuit-dropzone><circuit-dropzone id="second"><h-gate></h-gate></circuit-dropzone><circuit-dropzone><measurement-gate></measurement-gate></circuit-dropzone><span class="marker"></span></div>
${scripts}<script>
addEventListener('message', event => {
 if (event.source !== parent || event.data?.type !== 'measurement-recipe') return;
 const { question, step } = event.data;
 if (!['X','Y','Z'].includes(question) || !Number.isInteger(step) || step < 0 || step > 2) return;
 const first = document.getElementById('first'), second = document.getElementById('second');
 first.hidden = question === 'Z'; first.style.display = question === 'Z' ? 'none' : 'block';
 second.style.display = question === 'Y' ? 'block' : 'none';
 first.replaceChildren(document.createElement(question === 'Y' ? 's-dagger-gate' : 'h-gate'));
 document.querySelector('.sequence').style.width = (question === 'Y' ? 224 : question === 'X' ? 168 : 112) + 'px';
 document.querySelector('.marker').style.left = (56 * (step + 1)) + 'px';
});
</script></body></html>`
---
<iframe data-sequence data-qni-recipe srcdoc={document} title="Y の手順は S†、H、Measure です。現在は入力です。" height="76"></iframe>
<style>
  iframe { display:block; width:100%; height:76px; border:0; }
</style>
