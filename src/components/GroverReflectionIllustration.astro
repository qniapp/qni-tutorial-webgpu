---
interface Props { stage: 0 | 1 | 2 | 3 | 4 }
const {stage} = Astro.props
const annotated = stage < 2
const cy = annotated ? 132 : 72
const marker = `reflection-arrow-${stage}`
---
<div data-grover-reflection data-original-image data-stage={stage} data-marked="3">
  <svg viewBox={`0 0 640 ${annotated ? 204 : 144}`} aria-label={['初期振幅と座標','4点の平均座標','平均を中心とする反射','反射後の振幅と位相','最終状態'][stage]}>
    <defs><marker id={marker} markerUnits="userSpaceOnUse" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0 0 L6 3.5 L0 7" fill="none" stroke="#17252c" stroke-width="1.3" /></marker></defs>
    {stage === 0 && <>
      <text data-positive-label x="240" y="24" text-anchor="middle">[0, 0.5]</text>
      <text data-negative-label x="560" y="24" text-anchor="middle">[0, −0.5]</text>
    </>}
    {stage === 1 && <text x="320" y="24" text-anchor="middle">4 点の平均 = [0, 0.25]</text>}
    {Array.from({length:4},(_,i)=>{
      const x=80+160*i, initial=i===3?-.5:.5, reflected=i===3?1:0, amplitude=stage<3?initial:reflected
      const point=cy-56*initial, after=cy-56*reflected
      return <g data-state={i} data-initial={initial} data-average="0.25" data-reflected={reflected} data-amplitude={amplitude} tabindex="0" role="button" aria-label={`状態${i.toString(2).padStart(2,'0')}の座標と振幅を表示する`}>
        <title>{`状態${i.toString(2).padStart(2,'0')} - ` + (stage===1?`元の座標 [0, ${initial}]、平均 [0, 0.25]`:stage===2?`元の座標 [0, ${initial}]、反射後 [0, ${reflected}]`:`振幅 ${amplitude}、確率 ${amplitude*amplitude*100}%`)}</title>
        <circle class="unit" cx={x} cy={cy} r="56" fill={stage===4?'#f4f4f5':'#fff'} stroke="#64748b" stroke-width="4" opacity={stage===1||stage===2?'.35':'1'} />
        <circle data-disc cx={x} cy={cy} r={56*Math.abs(amplitude)} fill="#00a8e9" opacity={stage===1||stage===2?'.35':'1'} />
        <line data-phase x1={x} x2={x} y1={cy} y2={cy-56*amplitude} stroke="#17252c" stroke-width="2.5" opacity={stage===1||stage===2?'.35':'1'} />
        {stage===0 && <path data-coordinate-arrow d={i===3?`M${x-48} 40 Q${x-44} ${cy-12} ${x-5} ${point-6}`:`M240 40 L${x} ${point-8}`} fill="none" stroke="#17252c" stroke-width="2" stroke-dasharray="6 6" marker-end={`url(#${marker})`} />}
        {stage===1 && <path d={`M320 40 L${x} ${cy-22}`} fill="none" stroke="#17252c" stroke-width="2" stroke-dasharray="6 6" marker-end={`url(#${marker})`} />}
        {(stage===0||stage===2) && <circle data-origin cx={x} cy={point} r="3" fill="#fff" stroke="#17252c" stroke-width="2" />}
        {(stage===1||stage===2) && <circle data-mean cx={x} cy={cy-14} r="3.5" fill="#ee5d54" />}
        {(stage===2||stage===3) && <circle data-result cx={x} cy={after} r="3" fill="#fff" stroke="#17252c" stroke-width="2" />}
        {stage===2 && <path data-reflection-arrow d={`M${x-10} ${point} Q${x-32} ${cy-14} ${x-10} ${after}`} fill="none" stroke="#17252c" stroke-width="2" stroke-dasharray="6 6" marker-end={`url(#${marker})`} />}
        <circle class="focus-ring" cx={x} cy={cy} r="62" fill="none" stroke="#3aa99f" stroke-width="3" />
      </g>
    })}
  </svg>
  <output aria-live="polite" hidden></output>
</div>
<script>
import './grover-reflection-illustration'
</script>
<style>
[data-grover-reflection] { width:100%; max-width:704px; margin-inline:auto; }
svg { display:block; width:100%; height:auto; overflow:visible; }
text { font-family:inherit; font-size:22px; fill:#17252c; }
g[role=button] { cursor:pointer; outline:none; }
.focus-ring { opacity:0; }
g:focus-visible .focus-ring, g[aria-pressed=true] .focus-ring { opacity:1; }
output { display:block; text-align:center; font-size:14px; line-height:1.5; color:#344249; margin-top:8px; }
output[hidden] { display:none; }
</style>
