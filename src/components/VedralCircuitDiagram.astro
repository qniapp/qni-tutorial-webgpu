  <path d="M797 354 Q768 366 786 419" marker-end="url(#vedral-arrow)"/></g>
  {[228,334,381,486,604,710].map((x,i)=><g data-control-pair><line x1={x} x2={x} y1="94" y2="303" stroke="black" stroke-width="1.5" marker-end="url(#vedral-arrow)"/><circle cx={x} cy="94" r="6"/><circle cx={x} cy={i<2?141:i<4?176:259} r="6"/></g>)}
