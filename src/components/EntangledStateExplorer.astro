---
interface Props {
  view?: 'table' | 'reduced'
}
const { view = 'table' } = Astro.props
---

<entangled-state-explorer data-view={view} data-original-image>
  <p class="family">|ψ(t)⟩ = (|00⟩ + cos(t)|01⟩ + sin(t)|11⟩) / √2</p>
  <p class="hint">状態ラベルは |q1 q0⟩ です。角度を大きくすると、{view === 'table' ? '交差する積の差は' : 'q0 の矢印の長さは'}どうなるでしょうか? 「角度 t」スライダーを動かして確かめましょう。</p>
  <label>角度 t：<span data-angle-label>0</span>（0 から π/2、刻み π/120）
    <input data-angle type="range" min="0" max="60" step="1" value="0" aria-valuetext="t = 0" />
  </label>
  {view === 'table' ? (
    <>
      <svg data-diagram viewBox="0 0 360 340" role="img" aria-label="振幅表。行は q1、列は q0。a00 と a01 は 0.707、a10 と a11 は 0。">
        <title>2量子ビットの振幅表</title>
        <desc>行は q1、列は q0 です。円の半径は振幅の大きさ、面積は確率に比例します。</desc>
        <text x="180" y="22" text-anchor="middle">列 q0</text>
        <text x="140" y="47" text-anchor="middle">0</text>
        <text x="270" y="47" text-anchor="middle">1</text>
        <text x="12" y="85">行 q1</text>
        <text x="54" y="127">0</text><text x="54" y="257">1</text>
        <path class="grid" d="M76 58 H334 V316 H76 Z M205 58 V316 M76 187 H334" />
        {[['00', 140, 122, 1 / Math.sqrt(2)], ['01', 270, 122, 1 / Math.sqrt(2)], ['10', 140, 252, 0], ['11', 270, 252, 0]].map(([state, x, y, amplitude]) => (
          <g>
            <circle class="surface" cx={x} cy={y} r="43" />
            <circle class="disc" data-disc={state} cx={x} cy={y} r={43 * Number(amplitude)} />
            <circle class="rim" cx={x} cy={y} r="43" />
            <text x={x} y={Number(y) + 5} text-anchor="middle">|{state}⟩</text>
            <text data-amplitude={state} x={x} y={Number(y) + 59} text-anchor="middle">a{state} = {Number(amplitude).toFixed(3)}</text>
          </g>
        ))}
      </svg>
      <p class="diagonals"><span class="positive">対角線 a00 × a11</span> − <span class="negative">逆対角線 a01 × a10</span></p>
      <p class="hint">外側の円は振幅 1 です。2つの対角線の積が等しいときだけ、積状態になります。</p>
    </>
  ) : (
    <>
      <svg data-diagram viewBox="0 0 360 320" role="img" aria-label="q0 のブロッホ球の x-z 断面。点は x = 1、z = 0、長さ 1。">
        <title>q0 のブロッホ球の x-z 断面</title>
        <desc>点は x = cos(t)、z = 0 を動きます。y も 0 です。外側の円は長さ 1 です。</desc>
        <circle class="surface rim" cx="180" cy="150" r="110" />
        <path class="grid" d="M70 150 H290 M180 40 V260" />
        <text x="300" y="155">x</text><text x="188" y="32">z</text>
        <text x="62" y="174">−1</text><text x="286" y="174">1</text>
        <text x="188" y="58">1</text><text x="188" y="265">−1</text>
        <text x="162" y="170">0</text>
        <line data-vector x1="180" y1="150" x2="290" y2="150" />
        <circle data-point cx="290" cy="150" r="7" />
        <text x="180" y="304" text-anchor="middle">q0 だけを見ると、点は円の内側へ進みます。</text>
      </svg>
      <svg class="probabilities" viewBox="0 0 360 88" role="img" aria-label="q0 の測定確率。0 も 1 も常に 50%。">
        {[0, 1].map((state) => (
          <g>
            <text x="8" y={25 + state * 42}>|{state}⟩</text>
            <rect class="surface" x="50" y={8 + state * 42} width="230" height="24" />
            <rect class="disc" x="50" y={8 + state * 42} width="115" height="24" />
            <rect class="rim" x="50" y={8 + state * 42} width="230" height="24" />
            <text x="292" y={25 + state * 42}>50%</text>
          </g>
        ))}
      </svg>
      <p class="hint">測定確率は同じままでも、ブロッホベクトルの長さは変わります。</p>
    </>
  )}
  <output aria-live="polite" aria-atomic="true">{view === 'table'
    ? 't = 0\na00 × a11 = 0.0000\na01 × a10 = 0.0000\na00 × a11 − a01 × a10 = sin(t)/2 = 0.0000\n積に分けられる（差は正確に 0）。\n確率 |00⟩：50.0%、|01⟩：50.0%\n確率 |10⟩：0.0%、|11⟩：0.0%\n確率の合計：100.0%\n|+⟩q0 と |0⟩q1 の積状態です。'
    : 't = 0\n長さ = cos(t) = 1.0000\nρ01 = cos(t)/2 = 0.5000\nq0 の測定確率：0 は 50%、1 は 50%\n|+⟩q0 と |0⟩q1 の積状態です。'}</output>
  <p class="hint">「角度 t」スライダーの左端は 0、中間は π/4、右端はベル状態の π/2 です。</p>
</entangled-state-explorer>

<script>
  class EntangledStateExplorer extends HTMLElement {
    static state(n: number) {
      const t = n * Math.PI / 120
      const cos = n === 60 ? 0 : Math.cos(t)
      const sin = n === 0 ? 0 : Math.sin(t)
      return { cos, sin, amplitudes: [1 / Math.SQRT2, cos / Math.SQRT2, 0, sin / Math.SQRT2], determinant: sin / 2 }
    }

    static gcd(a: number, b: number): number {
      return b === 0 ? a : EntangledStateExplorer.gcd(b, a % b)
    }

    static angle(n: number) {
      if (n === 0) return '0'
      const divisor = EntangledStateExplorer.gcd(n, 120)
      const numerator = n / divisor
      return `${numerator === 1 ? '' : numerator}π/${120 / divisor}`
    }

    connectedCallback() {
      if (this.dataset.ready) return
      this.dataset.ready = 'true'
      const input = this.querySelector<HTMLInputElement>('[data-angle]')!
      const svg = this.querySelector<SVGSVGElement>('[data-diagram]')!
      const update = () => {
        const n = Number(input.value)
        const { cos, amplitudes, determinant } = EntangledStateExplorer.state(n)
        const angle = EntangledStateExplorer.angle(n)
        input.setAttribute('aria-valuetext', `t = ${angle}`)
        this.querySelector('[data-angle-label]')!.textContent = angle
        const endpoint = n === 0 ? '|+⟩q0 と |0⟩q1 の積状態です。'
          : n === 60 ? 'Bell 状態 (|00⟩ + |11⟩)/√2 です。' : ''
        let lines: string[]
        if (this.dataset.view === 'table') {
          const states = ['00', '01', '10', '11']
          states.forEach((state, i) => {
            this.querySelector(`[data-disc="${state}"]`)!.setAttribute('r', String(43 * amplitudes[i]))
            this.querySelector(`[data-amplitude="${state}"]`)!.textContent = `a${state} = ${amplitudes[i].toFixed(3)}`
          })
          svg.setAttribute('aria-label', `t = ${angle} の振幅表。行は q1、列は q0。${states.map((s, i) => `a${s} = ${amplitudes[i].toFixed(3)}`).join('、')}。`)
          const probabilities = amplitudes.map(amplitude => 100 * amplitude * amplitude)
          lines = [`t = ${angle}`,
            `a00 × a11 = ${(amplitudes[0] * amplitudes[3]).toFixed(4)}`,
            `a01 × a10 = ${(amplitudes[1] * amplitudes[2]).toFixed(4)}`,
            `a00 × a11 − a01 × a10 = sin(t)/2 = ${determinant.toFixed(4)}`,
            n === 0 ? '積に分けられる（差は正確に 0）。' : '積に分けられない（差は正確に 0 より大きい）。',
            `確率 |00⟩：${probabilities[0].toFixed(1)}%、|01⟩：${probabilities[1].toFixed(1)}%`,
            `確率 |10⟩：${probabilities[2].toFixed(1)}%、|11⟩：${probabilities[3].toFixed(1)}%`,
            `確率の合計：${probabilities.reduce((sum, probability) => sum + probability, 0).toFixed(1)}%`]
        } else {
          const x = String(180 + 110 * cos)
          this.querySelector('[data-vector]')!.setAttribute('x2', x)
          this.querySelector('[data-point]')!.setAttribute('cx', x)
          svg.setAttribute('aria-label', `t = ${angle}。q0 のブロッホ球の x-z 断面。x = ${cos.toFixed(4)}、z = 0、長さ ${cos.toFixed(4)}。`)
          lines = [`t = ${angle}`, `長さ = cos(t) = ${cos.toFixed(4)}`, `ρ01 = cos(t)/2 = ${(cos / 2).toFixed(4)}`, 'q0 の測定確率：0 は 50%、1 は 50%']
        }
        if (endpoint) lines.push(endpoint)
        this.querySelector('output')!.textContent = lines.join('\n')
      }
      input.addEventListener('input', update)
      update()
    }
  }
  if (!customElements.get('entangled-state-explorer')) {
    customElements.define('entangled-state-explorer', EntangledStateExplorer)
  }
</script>

<style>
  entangled-state-explorer { display:block; box-sizing:border-box; width:100%; max-width:540px; margin:1.5rem auto; padding:1rem; border:1px solid #4385BE; border-radius:8px; background:#FFFCF0; color:#100F0F; font:inherit; overflow-wrap:anywhere; }
  .family { margin-top:0; }
  .hint { color:#6F6E69; font-size:0.9em; line-height:1.6; }
  label { display:block; }
  input[type="range"] { display:block; box-sizing:border-box; width:100%; min-height:44px; margin:0; accent-color:#24837B; outline:none; }
  input[type="range"]:focus, input[type="range"]:focus-visible { outline:none; }
  input[type="range"]:focus-visible::-webkit-slider-thumb { box-shadow:0 0 0 3px #24837B; }
  input[type="range"]:focus-visible::-moz-range-thumb { box-shadow:0 0 0 3px #24837B; }
  svg { display:block; width:100%; height:auto; margin:auto; }
  text { fill:#100F0F; font:14px system-ui,sans-serif; }
  .surface { fill:#FFFCF0; }
  .disc { fill:#92BFDB; }
  .rim { fill:none; stroke:#4385BE; }
  .grid { fill:none; stroke:#DAD8CE; stroke-width:1.5; }
  [data-vector] { stroke:#4385BE; stroke-width:3; }
  [data-point] { fill:#3AA99F; stroke:#100F0F; stroke-width:1.5; }
  .diagonals { font-size:0.9em; line-height:1.8; }
  .positive { color:#205EA6; text-decoration:underline solid; text-underline-offset:4px; }
  .negative { color:#24837B; text-decoration:underline dashed; text-underline-offset:4px; }
  output { display:block; white-space:pre-line; margin:16px 0; padding:12px; border-radius:6px; background:#F2F0E5; font-variant-numeric:tabular-nums; line-height:1.7; }
</style>
