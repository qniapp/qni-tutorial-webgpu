<figure data-basis-projection data-original-image>
  <svg viewBox="0 0 360 350" aria-label="実数の振幅だけを持つ状態の矢印と、2 組の基底への射影">
    <defs><marker id="basis-state-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0 L10 5 L0 10 Z" fill="#4385BE" /></marker></defs>
    <circle cx="180" cy="175" r="118" fill="none" stroke="#DAD8CE" />
    <path d="M28 175 H332 M180 327 V23" class="axis" />
    <path d="M73 282 L287 68 M73 68 L287 282" class="diagonal" />
    <text x="307" y="196">|0⟩</text><text x="190" y="32">|1⟩</text>
    <text x="282" y="61">|+⟩</text><text x="282" y="304">|−⟩</text>
    <g data-projections fill="none" stroke="#24837B" stroke-width="2.5" stroke-dasharray="5 4"><path /><path /></g>
    <line data-arrow x1="180" y1="175" x2="282.19" y2="116" stroke="#4385BE" stroke-width="3" marker-end="url(#basis-state-arrow)" />
    <g data-point transform="translate(282.19 116)" tabindex="0" role="slider" aria-label="状態の矢印の角度" aria-valuemin="0" aria-valuemax="360" aria-valuenow="30">
      <circle class="focus-ring" r="16" fill="none" stroke="#24837B" stroke-width="2" />
      <circle r="22" fill="transparent" /><circle r="7" fill="#3AA99F" stroke="#100F0F" />
    </g>
    <text x="180" y="346" text-anchor="middle">横が |0⟩、縦が |1⟩ の振幅</text>
  </svg>
  <div class="buttons" role="group" aria-label="射影する基底">
    <button type="button" data-basis="01" aria-pressed="true">0/1 基底</button>
    <button type="button" data-basis="pm" aria-pressed="false">+/− 基底</button>
    <button type="button" data-plus>状態を |+⟩ にする</button>
  </div>
  <label>矢印の角度 t（度）<input type="range" min="0" max="360" step="1" value="30" /></label>
  <output aria-live="polite" aria-atomic="true">t = 30°
|0⟩ の成分 = 0.866、2 乗 = 75.0%
|1⟩ の成分 = 0.500、2 乗 = 25.0%</output>
  <figcaption>点をドラッグするか、スライダーで動かします。Tab キーで点を選ぶと、右・上で角度を 1 度増やし、左・下で減らせます。破線の先が、選んだ軸への射影です。これは実数の振幅だけを描いた図で、ブロッホ球ではありません。</figcaption>
</figure>
<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-basis-projection]')) {
    const svg = root.querySelector('svg')!
    const point = root.querySelector<SVGGElement>('[data-point]')!
    const input = root.querySelector('input')!
    const arrow = root.querySelector('[data-arrow]')!
    const paths = root.querySelectorAll('[data-projections] path')
    let angle = 30, basis = '01'
    function paint() {
      const t = angle * Math.PI / 180, x = Math.cos(t), y = Math.sin(t)
      const axes = basis === '01' ? [[1,0],[0,1]] : [[Math.SQRT1_2,Math.SQRT1_2],[Math.SQRT1_2,-Math.SQRT1_2]]
      const labels = basis === '01' ? ['0','1'] : ['+','−']
      const endX = 180+118*x, endY = 175-118*y
      arrow.setAttribute('x2', String(endX)); arrow.setAttribute('y2', String(endY))
      point.setAttribute('transform', `translate(${endX} ${endY})`)
      point.setAttribute('aria-valuenow', String(angle)); point.setAttribute('aria-valuetext', `${angle} 度`)
      input.value = String(angle); input.setAttribute('aria-valuetext', `${angle} 度`)
      const lines = axes.map(([u,v], i) => {
        const c = x*u+y*v
        paths[i].setAttribute('d', `M${endX} ${endY} L${180+118*c*u} ${175-118*c*v}`)
        return `|${labels[i]}⟩ の成分 = ${(Math.abs(c)<1e-10?0:c).toFixed(3)}、2 乗 = ${(100*c*c).toFixed(1)}%`
      })
      root.querySelector('output')!.textContent = [`t = ${angle}°（状態は変えず、読む軸を切り替えられます）`, ...lines].join('\n')
      root.querySelectorAll<HTMLButtonElement>('[data-basis]').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.basis === basis)))
    }
    input.addEventListener('input', () => { angle = Number(input.value); paint() })
    root.querySelectorAll<HTMLButtonElement>('[data-basis]').forEach(button => button.addEventListener('click', () => { basis = button.dataset.basis!; paint() }))
    root.querySelector('[data-plus]')!.addEventListener('click', () => { angle = 45; paint() })
    point.addEventListener('keydown', event => {
      const delta: Record<string,number> = {ArrowRight:1,ArrowUp:1,ArrowLeft:-1,ArrowDown:-1}
      if (!(event.key in delta) && event.key !== 'Home' && event.key !== 'End') return
      event.preventDefault()
      angle = event.key === 'Home' ? 0 : event.key === 'End' ? 360 : Math.max(0,Math.min(360,angle+delta[event.key]))
      paint()
    })
    function move(event: PointerEvent) {
      const matrix = svg.getScreenCTM(); if (!matrix) return
      const p = new DOMPoint(event.clientX,event.clientY).matrixTransform(matrix.inverse())
      if (Math.hypot(p.x-180,p.y-175)<2) return
      angle = Math.round((Math.atan2(175-p.y,p.x-180)*180/Math.PI+360)%360); paint()
    }
    svg.addEventListener('pointerdown', event => {
      if (!event.isPrimary || event.button !== 0) return
      event.preventDefault(); svg.setPointerCapture(event.pointerId); point.focus({preventScroll:true}); move(event)
    })
    svg.addEventListener('pointermove', event => { if (svg.hasPointerCapture(event.pointerId)) move(event) })
    for (const name of ['pointerup','pointercancel'] as const) svg.addEventListener(name, event => { if (svg.hasPointerCapture(event.pointerId)) svg.releasePointerCapture(event.pointerId) })
    paint()
  }
</script>
<style>
  figure { box-sizing:border-box; width:100%; max-width:540px; margin:24px auto; padding:16px; background:#FFFCF0; border:1px solid #4385BE; border-radius:8px; color:#100F0F; }
  svg { display:block; width:100%; height:auto; touch-action:none; user-select:none; cursor:crosshair; }
  text { font:14px system-ui,sans-serif; fill:#6F6E69; }
  .axis { fill:none; stroke:#6F6E69; stroke-width:1.5; }
  .diagonal { fill:none; stroke:#A6A09B; stroke-width:1.5; }
  [data-point] { outline:none; cursor:grab; }
  .focus-ring { opacity:0; } [data-point]:focus-visible .focus-ring { opacity:1; }
  .buttons { display:flex; flex-wrap:wrap; gap:8px; }
  button { min-height:44px; padding:6px 12px; background:#FFFCF0; color:inherit; border:1px solid #6F6E69; border-radius:6px; font:inherit; cursor:pointer; }
  button[aria-pressed=true] { background:#DDF1EF; border-color:#24837B; }
  label { display:block; margin-top:16px; }
  input { display:block; width:100%; min-height:44px; accent-color:#24837B; }
  button:focus-visible, input:focus-visible { outline:2px solid #24837B; outline-offset:3px; }
  output { display:block; white-space:pre-line; padding:12px; margin:12px 0; background:#F2F0E5; border-radius:6px; font-variant-numeric:tabular-nums; overflow-wrap:anywhere; line-height:1.7; }
  figcaption { color:#6F6E69; font-size:14px; line-height:1.6; }
</style>
