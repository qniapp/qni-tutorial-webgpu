      <span class="diagram-arrow size-4" set:html={minusSvg}></span>
      <span class="whitespace-nowrap rounded bg-emerald-500 p-2 text-xs text-white">pNOT</span>
      <span class="diagram-arrow size-4" set:html={arrowSvg}></span>
    </div>

    <div class="flex flex-row space-x-2">
      <qubit-circle data-amplitude="-0.70711" data-ket="0" data-size="lg" class="magnitude-lime" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0.70711" data-ket="1" data-size="lg" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle>
