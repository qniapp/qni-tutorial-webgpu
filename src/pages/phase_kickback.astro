.my-5 {margin-block:20px}.mb-8 {margin-bottom:32px}.mb-10 {margin-bottom:40px}.flex {display:flex}.flex-row {flex-direction:row}.flex-col {flex-direction:column}.items-center {align-items:center}.justify-center {justify-content:center}.space-x-2 {gap:8px}.space-y-4 {gap:16px}.relative {position:relative}.absolute {position:absolute}.inset-0 {inset:0}.m-auto {margin:auto}.h-8 {height:32px}.w-16 {width:64px}.text-zinc-300 {color:#DAD8CE}.transition-arrow {display:flex;width:100%;height:100%}.transition-arrow :global(svg) {width:100%;height:100%}.relative :global(h-gate) {width:24px;height:24px;font-size:24px}.flex :global(qubit-circle),.circle-row :global(qubit-circle) {margin-right:0;flex:none}
.circle-row {display:grid;grid-template-columns:repeat(8,32px);gap:8px;width:max-content;max-width:100%}
@media(max-width:600px) {.circle-row {grid-template-columns:repeat(4,32px)}}
