---
import TutorialLayout from '../layouts/TutorialLayout.astro'
import Sidenote from '../components/Sidenote.astro'
const base = import.meta.env.BASE_URL
---
<TutorialLayout title="Qni Tutorial" description="量子回路をブラウザで試す WebGPU 実験版">
  <p>旧 Qni Tutorial の内容を、Astro と Qni に少しずつ移しています<Sidenote id="webgpu-support">WebGPU が使える Windows / macOS の Chrome と Edge、macOS の Safari が対象です。回路はページを読み込み直すと初期状態に戻ります。</Sidenote>。</p>
  <h2>ページ一覧</h2>
  <ul>
    <li><a href={`${base}h_gate/`}>H ゲート</a>：シンプルな重ね合わせ状態を作る</li>
  </ul>
</TutorialLayout>
