---
import dividerSvg from '../assets/diagram-divider.svg?raw'
import downSvg from '../assets/diagram-down.svg?raw'
import TutorialLayout from '../layouts/TutorialLayout.astro'
import Sidenote from '../components/Sidenote.astro'
import Ket from '../components/Ket.astro'
const base = import.meta.env.BASE_URL
---
<TutorialLayout title="SWAP ゲート" description="量子ビットの交換" section="QPU 命令その 2" hasMath hasCircuit>


<p>
  今までの QPU 命令と異なり、SWAP ゲートは 2 つの量子ビットに作用します。 SWAP
  ゲートはその名の通り、2 つの量子ビットを入れ替える効果を持ちます。 たとえば次の回路では、<Ket label="0" /> と <Ket label="1" /> を SWAP ゲートによって入れ替えます。
</p>

<qni-webgpu-circuit palette={"[]"} circuit={"{\"cols\":[[\"|0>\",\"|1>\"],[\"Swap\",\"Swap\"],[\"Measure\",\"Measure\"]]}"} max-wire-count="1"></qni-webgpu-circuit>

<p>
  SWAP ゲートは 2 個 1 組で動作します。 当然ながら 1 個や 3 個の SWAP
  ゲートでは量子ビットの入れ替えは起こりません。 また、動作させるには同じ列に 2 個の SWAP
  ゲートを置く必要があります (簡単なクイズ: 次の無効な SWAP
  ゲートを動作させるにはどう動かせばよいでしょうか?)。
</p>

<qni-webgpu-circuit palette={"[]"} circuit={"{\"cols\":[[\"|0>\",\"|1>\"],[\"Swap\",1],[1,\"Swap\"],[\"Measure\",\"Measure\"]]}"} max-wire-count="1"></qni-webgpu-circuit>


</TutorialLayout>
<style>
  .my-5, .mt-5 { margin-top:20px; } .my-5 { margin-bottom:20px; } .mb-8 { margin-bottom:32px; }
  .flex { display:flex; } .flex-row { flex-direction:row; } .flex-col { flex-direction:column; }
  .items-center { align-items:center; } .justify-center { justify-content:center; } .justify-start { justify-content:flex-start; }
  .space-x-1 { gap:4px; } .space-x-2 { gap:8px; } .space-x-4 { gap:16px; }
  .relative { position:relative; } .absolute { position:absolute; } .inset-0 { inset:0; } .m-auto { margin:auto; }
  .h-12 { height:48px; } .w-12 { width:48px; } .h-12 :global(svg) { width:100%; height:100%; }
  .text-purple-500 { color:#A855F7; } .font-bold { font-weight:700; }
  .h-8 { height:32px; } .w-16 { width:64px; } .text-zinc-300 { color:#DAD8CE; }
  .h-8 :global(svg) { width:100%; height:100%; }
  .relative.h-8 :global(x-gate.qpu-operation-sm), .relative :global(measurement-gate.qpu-operation-sm) { font-size:24px; width:24px; height:24px; }
  .items-center > :global(phase-gate) { font-size:32px; }
  .mb-4 { margin-bottom:16px; } .space-y-4 { row-gap:16px; } .items-end { align-items:flex-end; }
  .text-2xl { font-size:24px; line-height:32px; } .mx-auto { margin-inline:auto; } .p-0 { padding:0; }
  .p-4 { padding:16px; } .border-l-4 { border-left:4px solid #60A5FA; } .bg-blue-50 { background:#EFF6FF; }
  .mt-4 { margin-top:16px; } .mb-2 { margin-bottom:8px; }
  .diagram-arrow { display:inline-flex; flex:none; color:#A3A3A3; }
  .size-6 { width:24px; height:24px; } .size-4 { width:16px; height:16px; }
  .diagram-arrow :global(svg) { width:100%; height:100%; fill:currentColor; }
  .whitespace-nowrap { white-space:nowrap; }
  .rounded { border-radius:4px; } .bg-emerald-500 { background:#3AA99F; color:#FFFCF0; padding:8px; }
  .text-sm { font-size:14px; line-height:20px; } .text-xs { font-size:12px; line-height:16px; }
  .items-center :global(quantum-circuit) { margin-block:20px; }
  :global(main quantum-circuit h-gate), :global(main .items-center > write-gate) { font-size:32px; margin:0; }
  .flex :global(qubit-circle) { margin-right:0; flex:none; }
  :global(main qubit-circle.magnitude-lime [data-part='disc']) { fill:#84CC16; }
  .overflow-auto, .overflow-x-auto { overflow:auto; }
  .list-decimal { list-style-type:decimal; }
  table { width:100%; border-collapse:collapse; font-size:14px; line-height:24px; }
  th { text-align:left; padding:0 8px 8px; border-bottom:1px solid #DAD8CE; }
  td { padding:8px; border-bottom:1px solid #DAD8CE; }
  th:first-child,td:first-child { padding-left:0; } td.align-middle { vertical-align:middle; }
  @media(min-width:768px) { [class~='md:w-7/12'] { width:58.333333%; margin-right:auto; } }
</style>
