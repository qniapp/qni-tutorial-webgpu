---
import TutorialLayout from '../layouts/TutorialLayout.astro'
---
<TutorialLayout title="Qubit circle stress test" description="本文の振幅円の描画測定 (ナビゲーションには掲載しない)">
  <p>件数は ?n=200、500、1600。WebGPU は読み込まない測定専用ページです。</p>
  <div id="stress-circles"></div>
</TutorialLayout>
<script>
  const requested = Number(new URL(location.href).searchParams.get('n') ?? 200)
  const count = [200, 500, 1600].includes(requested) ? requested : 200
  const fragment = document.createDocumentFragment()
  for (let i = 0; i < count; i++) {
    const circle = document.createElement('qubit-circle')
    const magnitude = (i % 9) / 8, phase = (i % 16) * Math.PI / 8
    circle.dataset.amplitudeReal = String(magnitude * Math.cos(phase))
    circle.dataset.amplitudeImag = String(magnitude * Math.sin(phase))
    circle.dataset.ket = String(i % 2)
    fragment.append(circle)
  }
  document.getElementById('stress-circles')!.append(fragment)
  await import('../components/qubit-circle')
  document.documentElement.dataset.qcReady = String(count)
  requestAnimationFrame(() => requestAnimationFrame(() => performance.mark('qc-painted')))
</script>
<style>
  #stress-circles { display: grid; grid-template-columns: repeat(auto-fill, minmax(56px, 1fr)); gap: 10px; }
</style>
