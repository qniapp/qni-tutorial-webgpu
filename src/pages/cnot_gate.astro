---
import dividerSvg from '../assets/diagram-divider.svg?raw'
import downSvg from '../assets/diagram-down.svg?raw'
import KetPairs from '../components/KetPairs.astro'
import TutorialLayout from '../layouts/TutorialLayout.astro'
import Sidenote from '../components/Sidenote.astro'
import Ket from '../components/Ket.astro'
const base = import.meta.env.BASE_URL
---
<TutorialLayout title="CNOT ゲート" description="条件付き X ゲート" section="QPU 命令その 2" hasMath hasCircuit>


<p>
  CNOT ゲートは 2 量子ビットに作用する QPU 命令で、条件付きで X ゲートを適用します。 CNOT
  ゲートは以下のように、条件となる量子ビットに置かれるコントロールゲートと、X ゲートの 2
  つから構成されます。 コントロールゲートを置いたビットを コントロールビット、X
  ゲートを置いたビットをターゲットビットと呼びます。 コントロールビットが 0
  でないとき、ターゲットビットに置いた X ゲートが発動します。
</p>

<div class="my-5 md:mr-auto md:w-7/12">
  <div class="flex flex-row justify-center">
    <circuit-step class="no-rotation p-0">
      <circuit-dropzone data-connect-bottom data-input-wire-quantum data-output-wire-quantum>
        <control-gate></control-gate>
      </circuit-dropzone>
      <circuit-dropzone data-connect-top data-input-wire-quantum data-output-wire-quantum>
        <x-gate></x-gate>
      </circuit-dropzone>
    </circuit-step>
  </div>
</div>

<p>
  以下の回路は CNOT の基本的な動きを見るものです。 最初の CNOT はビット 1
  をコントロールビット、ビット 2 をターゲットビットとして X ゲートを適用します。
  コントロールビットは <Ket label="1" /> なので X ゲートが発動し、ターゲットビットが反転して <Ket label="0" />
  から <Ket label="1" /> になっていることが分かります。 2 つめの CNOT では、コントロールビットは <Ket label="0" /> です。このため X ゲートは発動せず、ターゲットビットはそのままです。
</p>

<qni-webgpu-circuit palette={"[]"} circuit={"{\"cols\":[[\"|1>\",\"|0>\"],[\"•\",\"X\"],[\"Measure\",\"Measure\"],[\"|0>\",\"|0>\"],[\"•\",\"X\"],[\"Measure\",\"Measure\"]]}"} max-wire-count="1"></qni-webgpu-circuit>

<p>
  CNOT が量子ゲートたるゆえんは、コントロールビットが重ね合わせ状態を取れることです。
  たとえば、次のようにコントロールビットを H ゲートで重ね合わせにした状態で CNOT
  を適用することができます。この結果は <Ket label="0" /> と <Ket label="3" /> の等しい重ね合わせとなります。
</p>

<qni-webgpu-circuit palette={"[]"} circuit={"{\"cols\":[[\"|0>\",\"|0>\"],[\"H\"],[\"•\",\"X\"]]}"} max-wire-count="1"></qni-webgpu-circuit>

<p>
  この動作を順を追って見ていきましょう。 ビット 1 に H ゲートを適用すると、演算ペアのルール<Sidenote id="operation-pair" numbered><a href={`${base}operator_pair/`}>演算ペア</a>を参照。</Sidenote>により <Ket label="0" /> <Ket label="1" /> のペアに H
  ゲートが作用し、重ね合わせ状態ができます。
</p>

<div class="my-5 flex justify-center md:mr-auto md:w-7/12">
  <div class="flex flex-col items-center">
    <div class="mb-4 flex flex-row space-x-2">
      <qubit-circle data-amplitude="1" data-ket="0" data-size="lg" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="1" data-size="lg" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="2" data-size="lg" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="3" data-size="lg" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle>
    </div>

    <div class="mb-4 flex flex-col items-center space-y-2">
      <span class="diagram-arrow size-6" set:html={dividerSvg}></span>
      <div>H ゲートを 1 ビット目に適用</div>
      <span class="diagram-arrow size-6 mb-8" set:html={downSvg}></span>
    </div>

    <div class="flex flex-row space-x-2">
      <qubit-circle data-amplitude="0.7071067811865476" data-ket="0" data-size="lg" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0.7071067811865476" data-ket="1" data-size="lg" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="2" data-size="lg" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="3" data-size="lg" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle>
    </div>
  </div>
</div>

<p>
  次にビット 1 をコントロールビット、ビット 2 をターゲットビットとする CNOT を適用します。
  ターゲットはビット 2 なので、X ゲートの適用先は次の演算ペアとなります。
</p>

<figure>
  <KetPairs bit={2} qubits={2} />
</figure>

<p>
  ここで、コントロールビットであるビット 1 によって X ゲートを適用する演算ペアを選びます。
  ビットで見るために <Ket label="0" />, <Ket label="1" />, <Ket label="2" />, <Ket label="3" /> をそれぞれ 2 進数で表すと <Ket label="00" />, <Ket label="01" />, <Ket label="10" />, <Ket label="11" /> となります。 このうちビット 1 が立っているのは
  <Ket label="01" /> と <Ket label="11" /> (青色の円) だけなので、<Ket label="1" /> と <Ket label="3" /> のペアのみに X
  ゲートを適用します。
</p>

<div class="my-5 flex justify-center md:mr-auto md:w-7/12">
  <div class="flex flex-col items-center">
    <div class="mb-4 flex flex-row space-x-2">
      <qubit-circle data-amplitude="0.7071067811865476" data-ket="0" data-size="lg" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0.7071067811865476" data-ket="1" data-size="lg" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="2" data-size="lg" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="3" data-size="lg" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle>
    </div>

    <div class="mb-4 flex flex-col items-center space-y-2">
      <span class="diagram-arrow size-6" set:html={dividerSvg}></span>
      <div>CNOT (コントロールビット 1, ターゲットビット 2) を適用</div>
      <span class="diagram-arrow size-6 mb-8" set:html={downSvg}></span>
    </div>

    <div class="flex flex-row space-x-2">
      <qubit-circle data-amplitude="0.7071067811865476" data-ket="0" data-size="lg" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="1" data-size="lg" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="2" data-size="lg" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0.7071067811865476" data-ket="3" data-size="lg" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle>
    </div>
  </div>
</div>

<p>以上より、確かに <Ket label="0" /> と <Ket label="3" /> の等しい重ね合わせが得られました。</p>

<h2>CNOT の逆演算</h2>

<p>
  CNOT の逆演算は CNOT それ自身です。 以下のように CNOT を並べて見ると、2 つの X
  ゲートは発動する条件 (コントロールビット) が同じであること、また X ゲートはそれ自体が X
  ゲートの逆演算であることから、CNOT を並べると何もしないことが分かります。
</p>

<qni-webgpu-circuit palette={"[]"} circuit={"{\"cols\":[[\"|1>\",\"|0>\"],[\"•\",\"X\"],[\"•\",\"X\"],[\"Measure\",\"Measure\"]]}"} max-wire-count="1"></qni-webgpu-circuit>


</TutorialLayout>
<style>
  .my-5, .mt-5 { margin-top:20px; } .my-5 { margin-bottom:20px; } .mb-8 { margin-bottom:32px; }
  .flex { display:flex; } .flex-row { flex-direction:row; } .flex-col { flex-direction:column; }
  .items-center { align-items:center; } .justify-center { justify-content:center; } .justify-start { justify-content:flex-start; }
  .space-x-1 { gap:4px; } .space-x-2 { gap:8px; } .space-x-4 { gap:16px; }
  .relative { position:relative; } .absolute { position:absolute; } .inset-0 { inset:0; } .m-auto { margin:auto; }
  .h-12 { height:48px; } .w-12 { width:48px; } .h-12 :global(svg) { width:100%; height:100%; }
  .text-purple-500 { color:#A855F7; } .font-bold { font-weight:700; }
  .h-8 { height:32px; } .w-16 { width:64px; } .text-zinc-300 { color:#DAD8CE; }
  .h-8 :global(svg) { width:100%; height:100%; }
  .relative.h-8 :global(x-gate.qpu-operation-sm), .relative :global(measurement-gate.qpu-operation-sm) { font-size:24px; width:24px; height:24px; }
  .items-center > :global(phase-gate) { font-size:32px; }
  .mb-4 { margin-bottom:16px; } .space-y-4 { row-gap:16px; } .items-end { align-items:flex-end; }
  .text-2xl { font-size:24px; line-height:32px; } .mx-auto { margin-inline:auto; } .p-0 { padding:0; }
  .p-4 { padding:16px; } .border-l-4 { border-left:4px solid #60A5FA; } .bg-blue-50 { background:#EFF6FF; }
  .mt-4 { margin-top:16px; } .mb-2 { margin-bottom:8px; }
  .diagram-arrow { display:inline-flex; flex:none; color:#9CA3AF; }
  .size-6 { width:24px; height:24px; } .size-4 { width:16px; height:16px; }
  .diagram-arrow :global(svg) { width:100%; height:100%; fill:currentColor; }
  .whitespace-nowrap { white-space:nowrap; }
  .rounded { border-radius:4px; } .bg-emerald-500 { background:#3AA99F; color:#FFFCF0; padding:8px; }
  .text-sm { font-size:14px; line-height:20px; } .text-xs { font-size:12px; line-height:16px; }
  .items-center :global(quantum-circuit) { margin-block:20px; }
  :global(main quantum-circuit h-gate), :global(main .items-center > write-gate) { font-size:32px; margin:0; }
  .flex :global(qubit-circle) { margin-right:0; flex:none; }
  :global(main qubit-circle.magnitude-lime [data-part='disc']) { fill:#84CC16; }
  .overflow-auto, .overflow-x-auto { overflow:auto; }
  .list-decimal { list-style-type:decimal; }
  table { width:100%; border-collapse:collapse; font-size:14px; line-height:24px; }
  th { text-align:left; padding:0 8px 8px; border-bottom:1px solid #DAD8CE; }
  td { padding:8px; border-bottom:1px solid #DAD8CE; }
  th:first-child,td:first-child { padding-left:0; } td.align-middle { vertical-align:middle; }
  @media(min-width:768px) { [class~='md:w-7/12'] { width:58.333333%; margin-right:auto; } }
</style>
