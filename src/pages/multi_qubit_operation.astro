  .items-center { align-items:center; } .space-x-1 { gap:4px; } .space-x-2 { gap:8px; } .space-y-2 { gap:8px; }
  .mb-8 { margin-bottom:32px; } .overflow-auto { overflow:auto; }
  .flex :global(qubit-circle) { margin-right:0; flex:none; }
  .diagram-arrow { display:inline-flex; width:24px; height:24px; color:#A3A3A3; }
  .diagram-arrow :global(svg) { width:100%; height:100%; fill:currentColor; }
</style>
