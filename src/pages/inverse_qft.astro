<TutorialLayout title="逆 QFT" description="周期的に変化する位相を書き込む" section="量子フーリエ変換 (QFT)" hasMath hasCircuit>


<p>
  足し算回路に対する引き算回路と同様に、QFT にも逆回路が存在します。<strong>逆 QFT</strong>
  と呼ばれるこの逆回路を状態ベクトルに適用すると、次のように変化させることができます。
</p>

<div class="my-5 flex overflow-x-auto">
  <div class="flex flex-col items-center">
    <div class="pattern-row mb-4 flex flex-row items-center space-x-2">
      <qubit-circle data-amplitude="0" data-ket="0" data-size="lg" data-qubit-count="4" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="1" data-size="lg" data-qubit-count="4" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="1" data-ket="2" data-size="lg" data-qubit-count="4" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="3" data-size="lg" data-qubit-count="4" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="4" data-size="lg" data-qubit-count="4" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="5" data-size="lg" data-qubit-count="4" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="6" data-size="lg" data-qubit-count="4" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="7" data-size="lg" data-qubit-count="4" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle>
      <qubit-circle data-amplitude="0" data-ket="8" data-size="lg" data-qubit-count="4" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="9" data-size="lg" data-qubit-count="4" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="10" data-size="lg" data-qubit-count="4" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="11" data-size="lg" data-qubit-count="4" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="12" data-size="lg" data-qubit-count="4" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="13" data-size="lg" data-qubit-count="4" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="14" data-size="lg" data-qubit-count="4" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle> <qubit-circle data-amplitude="0" data-ket="15" data-size="lg" data-qubit-count="4" data-show-popup-amplitude data-show-popup-probability data-show-popup-phase></qubit-circle>
    </div>

    <div class="flex flex-col items-center space-y-2">
      <span class="diagram-arrow size-6" set:html={dividerSvg}></span>
